  "query": "\n        SELECT\n            chain_id,\n            block_hash,\n            crs_id,\n            crs_digest,\n            storage_urls\n        FROM kms_crs_activation_events\n        WHERE\n            ($1::bigint IS NULL OR chain_id = $1) AND\n            status = 'pending'\n            AND crs_content IS NULL\n        FOR UPDATE SKIP LOCKED\n        ",
