  "query": "\n                SELECT leaf_index, commitment, leaf_kind, handle, allowed_key,\n                       transaction_index\n                FROM solana_encrypted_state_leaves\n                WHERE encrypted_state = $1 AND leaf_kind = $2 AND handle = $3\n                  AND allowed_key IS NULL AND leaf_index < $4\n                ORDER BY leaf_index\n                LIMIT 1\n                ",
