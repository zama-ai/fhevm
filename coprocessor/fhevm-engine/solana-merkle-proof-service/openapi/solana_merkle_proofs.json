{
  "openapi": "3.1.0",
  "info": {
    "title": "Solana Merkle proofs",
    "description": "Inclusion proofs from the leaf record of Solana encrypted stores, for the KMS connector.",
    "contact": {
      "name": "Zama"
    },
    "license": {
      "name": "BSD-3-Clause-Clear",
      "identifier": "BSD-3-Clause-Clear"
    },
    "version": "1.0.0"
  },
  "paths": {
    "/v1/solana/merkle-proofs": {
      "post": {
        "tags": [
          "solana"
        ],
        "summary": "Builds the inclusion proof of each queried leaf from the leaf record.",
        "operationId": "merkle_proofs",
        "requestBody": {
          "content": {
            "application/cbor": {
              "schema": {
                "$ref": "#/components/schemas/MerkleProofRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "One answer per queried leaf, in request order",
            "content": {
              "application/cbor": {
                "schema": {
                  "$ref": "#/components/schemas/MerkleProofResponse"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request",
            "content": {
              "application/cbor": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Request signature refused",
            "content": {
              "application/cbor": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Signer over its rate or holding as many signed requests as it may, or no database connection free in time",
            "content": {
              "application/cbor": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Leaf record or KMS tx-sender set unavailable",
            "content": {
              "application/cbor": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "request_authorization": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorCode": {
        "type": "string",
        "description": "Error codes, in the vocabulary of the Direct HTTP Decryption Endpoint RFC.",
        "enum": [
          "malformed",
          "sender_authentication_failed",
          "upstream_transient",
          "rate_limited"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "code",
          "message",
          "retryable"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        }
      },
      "LeafQuery": {
        "type": "object",
        "description": "One leaf to prove. Byte fields are 32-byte CBOR byte strings.",
        "required": [
          "encryptedStore",
          "handle",
          "kind"
        ],
        "properties": {
          "encryptedStore": {
            "type": "string",
            "format": "binary",
            "description": "The encrypted store account whose MMR holds the leaf."
          },
          "handle": {
            "type": "string",
            "format": "binary"
          },
          "key": {
            "type": [
              "string",
              "null"
            ],
            "format": "binary",
            "description": "The allowed key; required for `allowed`, absent for `public`."
          },
          "kind": {
            "$ref": "#/components/schemas/LeafQueryKind"
          }
        }
      },
      "LeafQueryKind": {
        "type": "string",
        "description": "Which leaf authorizes the decrypt.",
        "enum": [
          "allowed",
          "public"
        ]
      },
      "MerkleProofOutcome": {
        "oneOf": [
          {
            "type": "object",
            "description": "The leaf is recorded. `leafCount` is the history the record had sealed\nwhen it built the proof; the caller verifies the path against the\non-chain account's peaks and retries when the record is behind the\nchain (`leafCount` smaller).",
            "required": [
              "leafIndex",
              "leafCount",
              "siblings",
              "status"
            ],
            "properties": {
              "leafCount": {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              "leafIndex": {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              "siblings": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Authentication path from the leaf to its peak, 32-byte byte strings."
              },
              "status": {
                "type": "string",
                "enum": [
                  "found"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "The account is recorded but no such leaf is, at `leafCount` leaves. Either\nit was never sealed or the record has not reached the block that sealed it.",
            "required": [
              "leafCount",
              "status"
            ],
            "properties": {
              "leafCount": {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              "status": {
                "type": "string",
                "enum": [
                  "notFound"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "The record never saw this account.",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "unknownAccount"
                ]
              }
            }
          }
        ],
        "description": "The answer for one queried leaf, in request order."
      },
      "MerkleProofRequest": {
        "type": "object",
        "required": [
          "leaves"
        ],
        "properties": {
          "leaves": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LeafQuery"
            },
            "description": "At most [`MAX_LEAVES_PER_REQUEST`] entries; answered in order."
          }
        }
      },
      "MerkleProofResponse": {
        "type": "object",
        "required": [
          "proofs"
        ],
        "properties": {
          "proofs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MerkleProofOutcome"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "request_authorization": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "`Zama-EIP712 expires=<unix seconds>, signature=0x<65 bytes>`: an EIP-712 signature over this path and the exact body, by the tx-sender of a node in a live KMS context of the canonical ProtocolConfig, valid for at most 60 s. The `shared/request-authorization` crate defines the typed data."
      }
    }
  }
}
