    ) external virtual {
        if (msg.sender != FHEVM_EXECUTOR_ADDRESS) revert CallerMustBeFHEVMExecutorContract();
        uint256 n = values.length;
        uint256 opCost;
        if (resultType == FheType.Uint8) {
            if (n <= 10) opCost = (3853 << 32) | 90900;
            else if (n <= 30) opCost = (10514 << 32) | 127000;
            else if (n <= 60) opCost = (18571 << 32) | 148000;
            else opCost = (30458 << 32) | 159000;
        } else if (resultType == FheType.Uint16) {
            if (n <= 10) opCost = (8965 << 32) | 95000;
            else if (n <= 30) opCost = (22759 << 32) | 136000;
            else if (n <= 60) opCost = (41669 << 32) | 162000;
            else opCost = (66679 << 32) | 184000;
        } else if (resultType == FheType.Uint32) {
            if (n <= 10) opCost = (19027 << 32) | 116000;
            else if (n <= 30) opCost = (47543 << 32) | 164000;
            else if (n <= 60) opCost = (87166 << 32) | 205000;
            else opCost = (141194 << 32) | 281000;
        } else if (resultType == FheType.Uint64) {
            if (n <= 10) opCost = (39436 << 32) | 139000;
            else if (n <= 30) opCost = (96604 << 32) | 216000;
            else opCost = (175918 << 32) | 306000;
        } else if (resultType == FheType.Uint128) {
            if (n <= 10) opCost = (80627 << 32) | 219000;
            else if (n <= 30) opCost = (203479 << 32) | 355000;
            else opCost = (376452 << 32) | 552000;
        } else {
            revert UnsupportedOperation();
        }
        _adjustAndCheckFheTransactionLimitArray(opCost, caller, values, result);
    }

    /**
