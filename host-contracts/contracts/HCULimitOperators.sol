    function checkHCUForFheRandBounded(FheType resultType, bytes32 result, address caller) external virtual {
        if (msg.sender != FHEVM_EXECUTOR_ADDRESS) revert CallerMustBeFHEVMExecutorContract();
        uint256 opCost;
        opCost = _cost(FHE_RAND_BOUNDED_COSTS_0, FHE_RAND_BOUNDED_COSTS_1, resultType);
        _adjustAndCheckFheTransactionLimitZeroOp(opCost, caller, result);
    }

    /**
     * @notice Check the homomorphic complexity units limit for FheSum.
     * @param resultType Result type.
     * @param values Input ciphertext handles.
     * @param result Result handle.
     * @param caller Original dapp caller address from FHEVMExecutor.
     */
    function checkHCUForFheSum(
        FheType resultType,
        bytes32[] calldata values,
        bytes32 result,
        address caller
    ) external virtual {
        if (msg.sender != FHEVM_EXECUTOR_ADDRESS) revert CallerMustBeFHEVMExecutorContract();
        uint256 n = values.length;
        uint256 opCost;
        if (resultType == FheType.Uint8) {
            if (n <= 10) opCost = (90900 << 32) | 90900;
            else if (n <= 30) opCost = (127000 << 32) | 127000;
            else if (n <= 60) opCost = (148000 << 32) | 148000;
            else opCost = (159000 << 32) | 159000;
        } else if (resultType == FheType.Uint16) {
            if (n <= 10) opCost = (95000 << 32) | 95000;
            else if (n <= 30) opCost = (136000 << 32) | 136000;
            else if (n <= 60) opCost = (162000 << 32) | 162000;
            else opCost = (184000 << 32) | 184000;
        } else if (resultType == FheType.Uint32) {
            if (n <= 10) opCost = (116000 << 32) | 116000;
            else if (n <= 30) opCost = (164000 << 32) | 164000;
            else if (n <= 60) opCost = (205000 << 32) | 205000;
            else opCost = (281000 << 32) | 281000;
        } else if (resultType == FheType.Uint64) {
            if (n <= 10) opCost = (139000 << 32) | 139000;
            else if (n <= 30) opCost = (216000 << 32) | 216000;
            else opCost = (306000 << 32) | 306000;
        } else if (resultType == FheType.Uint128) {
            if (n <= 10) opCost = (219000 << 32) | 219000;
            else if (n <= 30) opCost = (355000 << 32) | 355000;
            else opCost = (552000 << 32) | 552000;
        } else {
            revert UnsupportedOperation();
        }
        _adjustAndCheckFheTransactionLimitArray(opCost, caller, values, result);
    }

    /**
     * @notice Check the homomorphic complexity units limit for FheIsIn.
     * @param valueType Value type.
     * @param value Input ciphertext handle.
     * @param values Encrypted set ciphertext handles.
     * @param result Result handle.
     * @param caller Original dapp caller address from FHEVMExecutor.
     */
    function checkHCUForFheIsIn(
        FheType valueType,
        bytes32 value,
        bytes32[] calldata values,
        bytes32 result,
        address caller
    ) external virtual {
        if (msg.sender != FHEVM_EXECUTOR_ADDRESS) revert CallerMustBeFHEVMExecutorContract();
        uint256 n = values.length;
        uint256 opCost;
        if (valueType == FheType.Uint8) {
            if (n <= 10) opCost = (71300 << 32) | 71300;
            else if (n <= 30) opCost = (148000 << 32) | 148000;
            else if (n <= 60) opCost = (247000 << 32) | 247000;
            else opCost = (374000 << 32) | 374000;
        } else if (valueType == FheType.Uint16) {
            if (n <= 10) opCost = (103000 << 32) | 103000;
            else if (n <= 30) opCost = (218000 << 32) | 218000;
            else if (n <= 60) opCost = (378000 << 32) | 378000;
            else opCost = (605000 << 32) | 605000;
        } else if (valueType == FheType.Uint32) {
            if (n <= 10) opCost = (137000 << 32) | 137000;
            else if (n <= 30) opCost = (300000 << 32) | 300000;
            else if (n <= 60) opCost = (531000 << 32) | 531000;
            else opCost = (827000 << 32) | 827000;
        } else if (valueType == FheType.Uint64) {
            if (n <= 10) opCost = (218000 << 32) | 218000;
            else if (n <= 30) opCost = (492000 << 32) | 492000;
            else opCost = (879000 << 32) | 879000;
        } else if (valueType == FheType.Uint128) {
            if (n <= 10) opCost = (256000 << 32) | 256000;
            else if (n <= 30) opCost = (535000 << 32) | 535000;
            else opCost = (921000 << 32) | 921000;
        } else if (valueType == FheType.Uint160) {
            if (n <= 10) opCost = (286000 << 32) | 286000;
            else if (n <= 30) opCost = (584000 << 32) | 584000;
            else opCost = (885000 << 32) | 885000;
        } else if (valueType == FheType.Uint256) {
            if (n <= 10) opCost = (321000 << 32) | 321000;
            else if (n <= 30) opCost = (586000 << 32) | 586000;
            else opCost = (943000 << 32) | 943000;
        } else {
            revert UnsupportedOperation();
        }
        _adjustAndCheckFheTransactionLimitValueAndArray(opCost, caller, value, values, result);
    }

    /// FheMulDiv, scalar, work/latency: Uint8 495000/495000, Uint16 703000/703000, Uint32 1080000/1080000, Uint64 1921000/1921000.
    uint256 private constant FHE_MUL_DIV_SCALAR_COSTS_0 =
        0x00107ac000107ac0000aba18000aba1800078d9800078d980000000000000000;
    uint256 private constant FHE_MUL_DIV_SCALAR_COSTS_1 =
        0x000000000000000000000000000000000000000000000000001d4fe8001d4fe8;

    /// FheMulDiv, work/latency: Uint8 524000/524000, Uint16 766000/766000, Uint32 1311000/1311000, Uint64 2911000/2911000.
    uint256 private constant FHE_MUL_DIV_COSTS_0 = 0x0014011800140118000bb030000bb0300007fee00007fee00000000000000000;
    uint256 private constant FHE_MUL_DIV_COSTS_1 = 0x000000000000000000000000000000000000000000000000002c6b18002c6b18;

    /**
     * @notice Check the homomorphic complexity units limit for FheMulDiv.
     * @param resultType Result type.
     * @param scalarByte Scalar byte.
     * @param factor1 The first multiplication factor.
     * @param factor2 The second multiplication factor.
     * @param result Result.
     * @param caller Original dapp caller address from FHEVMExecutor.
     */
    function checkHCUForFheMulDiv(
        FheType resultType,
        bytes1 scalarByte,
        bytes32 factor1,
        bytes32 factor2,
        bytes32 result,
        address caller
    ) external virtual {
        if (msg.sender != FHEVM_EXECUTOR_ADDRESS) revert CallerMustBeFHEVMExecutorContract();
        uint256 opCost;
        if (scalarByte == FHE_MUL_DIV_FACTOR2_SCALAR) {
            opCost = _cost(FHE_MUL_DIV_SCALAR_COSTS_0, FHE_MUL_DIV_SCALAR_COSTS_1, resultType);

            _adjustAndCheckFheTransactionLimitOneOp(opCost, caller, factor1, result);
        } else if (scalarByte == FHE_MUL_DIV_FACTOR2_ENCRYPTED) {
            opCost = _cost(FHE_MUL_DIV_COSTS_0, FHE_MUL_DIV_COSTS_1, resultType);

            _adjustAndCheckFheTransactionLimitTwoOps(opCost, caller, factor1, factor2, result);
        } else {
            revert OnlyScalarOperationsAreSupported();
        }
    }

    /// @dev Meters an operation without encrypted inputs.
    function _adjustAndCheckFheTransactionLimitZeroOp(uint256 opCost, address caller, bytes32 result) internal virtual;

    /// @dev Meters an operation with one encrypted input.
    function _adjustAndCheckFheTransactionLimitOneOp(
        uint256 opCost,
        address caller,
        bytes32 op1,
        bytes32 result
    ) internal virtual;

    /// @dev Meters an operation with two encrypted inputs.
    function _adjustAndCheckFheTransactionLimitTwoOps(
        uint256 opCost,
        address caller,
        bytes32 op1,
        bytes32 op2,
        bytes32 result
    ) internal virtual;

    /// @dev Meters an operation with three encrypted inputs.
    function _adjustAndCheckFheTransactionLimitThreeOps(
        uint256 opCost,
        address caller,
        bytes32 op1,
        bytes32 op2,
        bytes32 op3,
        bytes32 result
    ) internal virtual;

    /// @dev Meters an operation on an array of handles.
    function _adjustAndCheckFheTransactionLimitArray(
        uint256 opCost,
        address caller,
        bytes32[] calldata values,
        bytes32 result
    ) internal virtual;

    /// @dev Meters an operation on a handle and an array of handles.
    function _adjustAndCheckFheTransactionLimitValueAndArray(
        uint256 opCost,
        address caller,
        bytes32 value,
        bytes32[] calldata values,
        bytes32 result
    ) internal virtual;
}
