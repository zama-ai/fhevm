  "query": "\n                SELECT req_status as \"req_status!: ReqStatus\"\n                FROM public_decrypt_req\n                WHERE updated_at < NOW() - make_interval(secs => $1)\n                  AND req_status IN ('completed'::req_status, 'timed_out'::req_status, 'failure'::req_status)\n                ",
