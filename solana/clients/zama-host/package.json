{
  "name": "@fhevm/solana-zama-host",
  "private": true,
  "version": "0.15.0-0",
  "description": "Codama client for the zama-host program. Regenerated by npm run codegen:solana in sdk/js-sdk.",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./client": {
      "types": "./dist/types/finalizedClient.d.ts",
      "import": "./dist/esm/finalizedClient.js",
      "require": "./dist/cjs/finalizedClient.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "setup": "npm ci && npm run build",
    "build": "rm -rf dist && tsc --declaration --declarationDir dist/types && tsc --module commonjs --moduleResolution node --ignoreDeprecations 6.0 --verbatimModuleSyntax false --outDir dist/cjs && printf '{\"type\":\"commonjs\"}' > dist/cjs/package.json",
    "check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@solana/kit": "^8.4.0",
    "@solana/program-client-core": "^8.4.0",
    "@solana/kit-plugin-rpc": "^0.19.0"
  },
  "peerDependenciesMeta": {
    "@solana/kit-plugin-rpc": {
      "optional": true
    }
  },
  "devDependencies": {
    "@solana/kit": "8.4.0",
    "@solana/kit-plugin-rpc": "0.19.0",
    "@solana/program-client-core": "8.4.0",
    "@types/node": "22.20.1",
    "typescript": "6.0.3"
  },
  "license": "BSD-3-Clause-Clear"
}
