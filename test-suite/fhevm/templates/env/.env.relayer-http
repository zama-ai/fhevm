# =============================================================================
# relayer-http
# =============================================================================
# The configuration itself is rendered by fhevm-cli into runtime/config/relayer-http.yaml
# (templates/config/relayer-http.yaml + KMS committee, thresholds, chain ids, ProtocolConfig).

# FhevmSig signing key, named by kms_aggregator.auth.signer.value_env. Rewritten by fhevm-cli to the
# e2e test key (KMS_CONNECTOR_ALLOWED_SENDER_PRIVATE_KEY in .env.test-suite), whose address every
# connector proxy allows (KMS_CONNECTOR_ALLOWED_SENDERS in .env.kms-connector).
# IMPORTANT: For testing only
RELAYER_SIGNER_KEY=

RUST_LOG=warn,relayer_http=debug
