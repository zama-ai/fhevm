# =============================================================================
# DATABASE CONFIGURATION - SENSITIVE
# =============================================================================
# IMPORTANT: For testing only - move to secure storage in production
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Password of the prf_service role prf-service logs in as: static/config/database/initdb creates it,
# and each coprocessor migration grants its rights on `pads`.
PRF_SERVICE_DATABASE_PASSWORD=prf_service
# Password of the pad_worker role the pad-worker logs in as, created the same way.
PAD_WORKER_DATABASE_PASSWORD=pad_worker
