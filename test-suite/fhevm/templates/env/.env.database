# IMPORTANT: For testing only - move to secure storage in production
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# The role prf-service logs in as. static/config/database/initdb creates it, and each coprocessor
# migration grants it its rights on `pads`.
PRF_SERVICE_DATABASE_USER=prf_service
PRF_SERVICE_DATABASE_PASSWORD=prf_service
