# =============================================================================
# WALLET CONFIGURATION - SENSITIVE
# =============================================================================
# IMPORTANT: For testing only - move to secure storage in production
MNEMONIC=adapt mosquito move limb mobile illegal tree voyage juice mosquito burger raise father hope layer

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================
CHAIN_ID_GATEWAY=54321
CHAIN_ID_HOST=12345
RPC_URL=http://host-node:8545

GATEWAY_RPC_URL=http://gateway-node:8546

# =============================================================================
# CONTRACT ADDRESSES
# =============================================================================
## Gateway
GATEWAY_CONFIG_ADDRESS=0x576Ea67208b146E63C5255d0f90104E25e3e04c7
DECRYPTION_ADDRESS=0xF0bFB159C7381F7CB332586004d8247252C5b816
INPUT_VERIFICATION_ADDRESS=0x3b12Fc766Eb598b285998877e8E90F3e43a1F8d2
# $ZAMA token + payment contract: scripts/gen_handles.ts provisions the decryption
# fee allowance with these.
ZAMA_OFT_ADDRESS=0x5ffdaAB0373E62E2ea2944776209aEf29E631A64
PROTOCOL_PAYMENT_ADDRESS=0x1ceFA8E3F3271358218B52c33929Cf76078004c1

## Host
KMS_VERIFIER_CONTRACT_ADDRESS=0xa1880e99d86F081E8D3868A8C4732C8f65dfdB11
ACL_CONTRACT_ADDRESS=0x05fD9B5EFE0a996095f42Ed7e77c390810CF660c
INPUT_VERIFIER_CONTRACT_ADDRESS=0x857Ca72A957920Fa0FB138602995839866Bd4005
FHEVM_EXECUTOR_CONTRACT_ADDRESS=0xcCAe95fF1d11656358E782570dF0418F59fA40e1
HCU_LIMIT_CONTRACT_ADDRESS=0xAb30999D17FAAB8c95B2eCD500cFeFc8f658f15d
# accounts[9] deployer — needed for HCU limit owner-restricted tests
DEPLOYER_PRIVATE_KEY=2d24c36c57e6bfbf90c43173481cc00edcbd1a3922de5e5fdb9aba5fc4e0fafd

# =============================================================================
# SERVICE ENDPOINTS
# =============================================================================
RELAYER_URL=http://fhevm-relayer:3000
# kms-connector HTTP decryption entry points (https URL of each party's connector proxy), comma
# separated, one per KMS party. Empty = the "Connector HTTP" suites skip.
KMS_CONNECTOR_ENDPOINT_URLS=
# Each party's KMS tx-sender address, aligned with the URLs (rendered by fhevm-cli).
KMS_CONNECTOR_TX_SENDER_ADDRESSES=
# Key signing the `FhevmSig` requests (keccak256("fhevm-e2e-kms-connector-sender")); its address is
# KMS_CONNECTOR_ALLOWED_SENDERS in .env.kms-connector.
# IMPORTANT: For testing only.
KMS_CONNECTOR_ALLOWED_SENDER_PRIVATE_KEY=0xdcd7f0c4990a3df000d45f6eb2728a8cf93f0d16b1f6bdffbe07f5a250250e6c
# Trust the proxies' checked-in self-signed test certificate (mounted by the compose file).
NODE_EXTRA_CA_CERTS=/etc/kms-connector/proxy/tls.crt
# MPC threshold `t` of the KMS cluster (rendered per scenario); decryption quorum is 2t+1.
KMS_THRESHOLD=1
# Each coprocessor's proxy (https URL), the signer it serves, its fake prf-service's request
# count URL and the proxy's metrics URL, aligned (rendered by fhevm-cli). Empty = the
# "Coprocessor proxy" suite skips.
COPROCESSOR_PROXY_URLS=
COPROCESSOR_SIGNER_ADDRESSES=
PRF_SERVICE_FAKE_COUNT_URLS=
COPROCESSOR_PROXY_METRICS_URLS=
# KMS party 1's connector key (rendered by fhevm-cli): the suite signs as that KMS tx-sender.
# Removed with the suite when the RFC-038 pad connector and its e2e land.
KMS_CONNECTOR_PRIVATE_KEY=
# The coprocessor proxies' checked-in self-signed test certificate (mounted by the compose file).
COPROCESSOR_PROXY_CA_CERT=/etc/coprocessor-proxy/tls.crt

# =============================================================================
# CONSENSUS WATCHDOG (active when both vars are set)
# =============================================================================
GATEWAY_RPC_URL=http://gateway-node:8546
CIPHERTEXT_COMMITS_ADDRESS=0xeAC2EfFA07844aB326D92d1De29E136a6793DFFA
