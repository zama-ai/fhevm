# Single source of truth for the Solana e2e image tags (FI#1546).
#
# Consumed by both shell (solana/scripts/e2e/clean-e2e.sh sources this file) and TS
# (src/solana/images.ts parses it) so the tags cannot drift across call sites.
#
# All images are pinned to reproducible COMMIT-SHA tags rebuilt from the feature branches
# (the earlier `solana-ud*` PoC tags were pruned from ghcr). CORE_VERSION (the kms-core server)
# is built from the merged kms `feature/solana` @ 024279f8 — the linker-v1 merge (kms#751), the
# same commit the vendored TKMS WASM client and the linker vectors are built from (one artifact
# set, see sdk/js-sdk/src/wasm/tkms/KMS_BUILT_FROM). The connector + relayer images are built
# from fhevm `feature/solana` @ 4f42734.
CORE_VERSION=024279f
CONNECTOR_GW_LISTENER_VERSION=4f42734
CONNECTOR_KMS_WORKER_VERSION=4f42734
RELAYER_IMAGE_REPOSITORY=ghcr.io/zama-ai/fhevm/relayer
RELAYER_VERSION=4f42734
