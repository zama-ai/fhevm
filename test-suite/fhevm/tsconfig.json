{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "types": [
      "bun-types"
    ],
    "paths": {
      "@demo-dapp/*": [
        "../../solana/demo-dapp/src/*"
      ]
    }
  },
  "include": [
    "solana-two-holder-transfer.ts",
    "src/cli.ts",
    "src/layout.ts",
    "src/types.ts",
    "src/**/*.ts",
    "scripts/**/*.ts",
    "e2e/**/*.ts",
    "demo/**/*.ts"
  ]
}
