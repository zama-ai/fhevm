{
  "name": "@fhevm/local-cli",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "rm -rf node_modules/@fhevm/sdk && ln -s ../../../../sdk/js-sdk/src node_modules/@fhevm/sdk && rm -rf node_modules/@fhevm/confidential-token && ln -s ../../../../solana/clients/confidential-token node_modules/@fhevm/confidential-token",
    "check": "tsc --noEmit",
    "compat-smoke": "bun run src/compat/smoke.ts",
    "test": "bun test src",
    "test:e2e:harness": "bun test e2e/harness",
    "test:e2e": "bun run e2e/run.ts",
    "test:demo": "bun test demo",
    "demo": "bun run demo/cli.ts",
    "demo:seed": "bun run demo/seed.ts",
    "demo:operator": "bun run demo/operator-server.ts",
    "demo:check-cors": "bun run demo/checkBrowserReality.ts",
    "demo:smoke": "bun run demo/smoke.ts",
    "start": "bun run src/cli.ts"
  },
  "dependencies": {
    "@fhevm/confidential-token": "file:../../solana/clients/confidential-token",
    "@fhevm/sdk": "file:../../sdk/js-sdk/src",
    "@solana/kit": "6.10.0",
    "@solana/program-client-core": "6.10.0",
    "citty": "^0.1.6",
    "viem": "^2.46.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@sqds/multisig": "^2.1.4",
    "bun-types": "1.3.10",
    "typescript": "^5.9.2"
  }
}
