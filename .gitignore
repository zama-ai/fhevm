# General ignores
#-------------------------------------------------------------------------------
# Operating System files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.swp
*.swo
*~

# IDE and editor specific files
.idea/
.vscode/
.claude/
*.suo
*.user
*.userosscache
*.sln.docstates
*.project.json
*.tmproj
*.sublime-project
*.sublime-workspace

# Log files (generic, will catch logs from any tool/language)
*.log
logs/
*.log.*

# Environment files - typically sensitive, should not be committed
.env
.env.*
!.env.example
!.env.sample
# Allow shared env templates in subprojects
!test-suite/e2e/.env.devnet
!test-suite/fhevm/templates/env/
!test-suite/fhevm/templates/env/.env.*
# If you have .env files specific to subprojects, e.g. subproject/.env,
# the .env rule above will catch them.

# Build output & temporary directories (generic)
.cache/
.buildx-cache/
temp/
tmp/
ci/__pycache__/

# Archives
*.zip
*.tar
*.gz
*.rar
*.7z

# Local configuration and backup files
.local/
*-local.*
.local
.fhevm/

# Node.js specific
#-------------------------------------------------------------------------------
# Dependency directories
node_modules/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Compiled TypeScript files info
*.tsbuildinfo

# Build output directories
build/
!sdk/js-sdk/scripts/build/
!sdk/js-sdk/scripts/build/**
dist/
out/
public/ # If serving static assets from a 'public' dir built by a framework
.next/
.nuxt/
.svelte-kit/

# Test reports and coverage (often from Node.js tools like Jest, Mocha)
coverage/
.nyc_output/
junit/
mochawesome-report/

# Rust specific
#-------------------------------------------------------------------------------
# Build artifacts directory
target/

.solana-test-ledger

# dead-surface-check.sh --self-test plants these inside source trees and deletes them on exit.
# Ignored so an interrupted run cannot be committed. Note what this does NOT give you: an ignored file
# is precisely what `git status` will not show, so a leftover is invisible here. The script's own
# startup guard is what catches one — it refuses to run while any of these exists, because a leftover
# fixture and a real violation look identical in a report. The list below and SELFTEST_FIXTURES in the
# script have to stay in step; the caller fixture was missing from this list for one commit.
solana/crates/zama-fhe/.dead-surface-selftest.md
solana/crates/zama-fhe/src/dead_surface_selftest.rs
solana/crates/zama-fhe/src/dead_surface_selftest_caller.rs
solana/programs/zama-host/src/dead_surface_selftest.rs
solana/demo-dapp/src/deadSurfaceSelftest.ts
