# The e2e test-suite image, plus what Antithesis needs to drive it:
# - Hardhat downloads solc on first compile and Antithesis has no internet, so compile
#   once here to cache it (clean first: the base ships compiled artifacts).
# - Test Composer commands under /opt/antithesis/test/v1/e2e, generated by
#   build-images.sh from the preview-env e2e test list.
ARG BASE
FROM ${BASE}
RUN npx hardhat clean && npx hardhat compile
COPY prepare.sh /opt/antithesis/prepare.sh
COPY test/ /opt/antithesis/test/v1/e2e/
