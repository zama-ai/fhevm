{
  "name": "codegen",
  "bin": "./dist/_esm/index.js",
  "dependencies": {
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "commander": "^14.0.1",
    "prettier": "^3.3.3",
    "prettier-plugin-solidity": "^1.1.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^20.0.0",
    "eslint": "10.5.0",
    "typescript": ">=5.0.4",
    "typescript-eslint": "8.62.0"
  },
  "imports": {
    "#lib": {
      "types": "./dist/_types/index.d.ts",
      "import": "./dist/_esm/index.js"
    }
  },
  "scripts": {
    "postinstall": "npm run rebuild",
    "lint": "eslint --config ./eslint.config.mjs",
    "prettier:check": "prettier --config ./.prettierrc.json --check \"**/*.{js,json,md,sol,ts,yml}\"",
    "prettier:write": "prettier --config ./.prettierrc.json --write \"**/*.{js,json,md,sol,ts,yml}\"",
    "rebuild": "npm run clean && npm run build",
    "clean": "rm -rf ./dist",
    "build": "tsc --project ./tsconfig.json",
    "tsc": "tsc --project ./tsconfig.json --noEmit",
    "test": "echo 'no ci test yet'"
  }
}
