{
  "printWidth": 120,
  "plugins": ["prettier-plugin-solidity"],
  "overrides": [
    {
      "files": ["*.ts", "*.js", "*.cjs", "*.mjs"],
      "options": {
        "singleQuote": true
      }
    },
    {
      "files": "*.sol",
      "options": {
        "singleQuote": false
      }
    }
  ]
}
