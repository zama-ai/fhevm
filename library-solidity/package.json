{
  "name": "@fhevm/solidity",
  "description": "A Solidity library for interacting with fhevm protocol",
  "version": "0.15.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "lib/FHE.sol",
  "scripts": {
    "build": "hardhat build && npm run lint",
    "clean": "rimraf ./artifacts ./cache ./coverage ./typechain-types ./fhevmTemp ./coverage.json",
    "codegen": "./codegen/codegen.mjs lib --config ./codegen.config.json --verbose",
    "codegen:overloads": "./codegen/codegen.mjs overloads --config ./codegen.config.json --verbose --force",
    "forge:soldeer": "forge soldeer install",
    "hello": "hardhat run hello.ts",
    "lint": "npm run tsc && npm run lint:ts && npm run prettier:check",
    "lint:ts": "eslint --config ./eslint.config.mjs",
    "postinstall": "if command -v forge >/dev/null 2>&1; then npm run forge:soldeer; else echo 'forge not found: skipping forge soldeer install (install Foundry, then run: npm run forge:soldeer)'; fi",
    "prettier": "prettier --write \"**/*.{js,json,md,sol,ts,yml}\"",
    "prettier:check": "prettier --check \"**/*.{js,json,md,sol,ts,yml}\"",
    "test": "npm run test:publish",
    "test:forge": "forge test",
    "test:publish": "node --test publish/package.test.mjs",
    "tsc": "tsc --project ./tsconfig.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zama-ai/fhevm.git"
  },
  "author": "",
  "license": "BSD-3-Clause-Clear",
  "bugs": {
    "url": "https://github.com/zama-ai/fhevm/issues"
  },
  "homepage": "https://github.com/zama-ai/fhevm",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fhevm/host-contracts": "*",
    "@openzeppelin/contracts": "^5.0.1",
    "@openzeppelin/contracts-upgradeable": "5.0.2",
    "@types/chai": "^4.3.4",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.14.9",
    "bigint-buffer": "^1.1.5",
    "chai": "^4.3.7",
    "dotenv": "^16.0.3",
    "eslint": "10.5.0",
    "ethers": "^6.13.4",
    "hardhat": "^3.21.2",
    "prettier": "^3.4.2",
    "prettier-plugin-solidity": "^1.1.3",
    "rimraf": "^4.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.62.0"
  },
  "optionalDependencies": {
    "solidity-comments-darwin-arm64": "0.1.1",
    "solidity-comments-linux-x64-gnu": "0.1.1"
  },
  "dependencies": {
    "encrypted-types": "^0.0.4"
  }
}
