pragma solidity ^0.8.24;

// AUTOGENERATED from internal/templates/ComputeAddresses.s.sol.template by
// `npm run generate:compute-addresses`. DO NOT EDIT — edit the template, then regenerate.
//
// Substituted from internal/constants.ts: the config remapping prefix (fhevm-config-0.12.0/),
// and everything keyed by the address set — the nonce layout table, the address declarations, the log
// lines and the emitted constants. Those four are derived from ADDRESS_NAMES and NONCE_OFFSET, so a new
// host address needs no edit here. Everything else is literal Solidity.

import {Script, console} from "forge-std/Script.sol";

/**
 * @title ComputeAddresses
 * @notice Step 1 of the two-phase FHEVM host deployment.
 *
 * Computes the deterministic CREATE addresses for all 9 UUPS proxies and
 * PauserSet, then writes them as the `fhevm-config-0.12.0/addresses.sol` the
 * contracts import, so that they can be compiled with the correct baked-in
 * addresses before the actual deployment runs.
 *
 * Usage (from the package root):
 *
 *   DEPLOYER_PRIVATE_KEY=<key> forge script pkg/forge/script/ComputeAddresses.s.sol \
 *       --rpc-url <rpc>
 *
 * After running this script, execute `forge build` with `fhevm-config-0.12.0/`
 * remapped to ADDRESSES_DIR, then deploy with the same deployer key and nonce.
 * Nothing else may send from the deployer in between: every address below
 * derives from the nonce read here, so one stray transaction moves them all.
 *
 * Deployment nonce layout (starting at N = deployer's nonce at script start).
 * Note this differs from forge-fhevm's: a single shared EmptyUUPSProxy at N+2
 * serves every proxy but ACL, rather than one implementation per slot.
 *
 *   N+0  EmptyUUPSProxyACL
 *   N+1  ERC1967Proxy (ACL)                 → ACL_ADDRESS
 *   N+2  EmptyUUPSProxy (shared implementation)
 *   N+3  ERC1967Proxy (FHEVMExecutor)       → FHEVM_EXECUTOR_ADDRESS
 *   N+4  ERC1967Proxy (KMSVerifier)         → KMS_VERIFIER_ADDRESS
 *   N+5  ERC1967Proxy (InputVerifier)       → INPUT_VERIFIER_ADDRESS
 *   N+6  ERC1967Proxy (HCULimit)            → HCU_LIMIT_ADDRESS
 *   N+7  ERC1967Proxy (CleartextArithmetic) → CLEARTEXT_ARITHMETIC_ADDRESS
 *   N+8  ERC1967Proxy (CleartextDB)         → CLEARTEXT_DB_ADDRESS
 *   N+9  PauserSet                          → PAUSER_SET_ADDRESS
 *   N+10 ACLOwner                            (address referenced by nothing)
 *
 * Mirrors pkg/ts/addresses.ts, which is where the order is actually decided.
 */
contract ComputeAddresses is Script {
    // Where the generated config goes. Deliberately NOT internal/placeholders/:
    // that holds the committed marker addresses the templates and the shipped
    // pkg/forge bytecode are built from, and overwriting it corrupts both.
    string private constant ADDRESSES_DIR = "internal/.deploy-config";
    string private constant ADDRESSES_FILE = "internal/.deploy-config/addresses.sol";

    function run() external {
        address deployer = vm.addr(vm.envUint("DEPLOYER_PRIVATE_KEY"));
        uint64 nonce = vm.getNonce(deployer);

        address aclProxy = vm.computeCreateAddress(deployer, nonce + 1);
        address fhevmExecutorProxy = vm.computeCreateAddress(deployer, nonce + 3);
        address kmsVerifierProxy = vm.computeCreateAddress(deployer, nonce + 4);
        address inputVerifierProxy = vm.computeCreateAddress(deployer, nonce + 5);
        address hcuLimitProxy = vm.computeCreateAddress(deployer, nonce + 6);
        address cleartextArithmeticProxy = vm.computeCreateAddress(deployer, nonce + 7);
        address cleartextDbProxy = vm.computeCreateAddress(deployer, nonce + 8);
        address pauserSetAddr = vm.computeCreateAddress(deployer, nonce + 9);

        console.log("Deployer:                     ", deployer);
        console.log("Starting nonce:               ", nonce);
        console.log("ACL_ADDRESS:                  ", aclProxy);
        console.log("FHEVM_EXECUTOR_ADDRESS:       ", fhevmExecutorProxy);
        console.log("KMS_VERIFIER_ADDRESS:         ", kmsVerifierProxy);
        console.log("INPUT_VERIFIER_ADDRESS:       ", inputVerifierProxy);
        console.log("HCU_LIMIT_ADDRESS:            ", hcuLimitProxy);
        console.log("CLEARTEXT_ARITHMETIC_ADDRESS: ", cleartextArithmeticProxy);
        console.log("CLEARTEXT_DB_ADDRESS:         ", cleartextDbProxy);
        console.log("PAUSER_SET_ADDRESS:           ", pauserSetAddr);

        // Appended one constant at a time rather than in one string.concat over
        // all ten: with this many arguments legacy codegen runs out of stack
        // slots ("Stack too deep"), and scripts are compiled with via_ir off.
        string memory content = string.concat(
            "// SPDX-License-Identifier: BSD-3-Clause-Clear\n",
            "\n",
            "pragma solidity ^0.8.24;\n",
            "\n",
            "// Auto-generated by pkg/forge/script/ComputeAddresses.s.sol - do not edit by hand.\n",
            "// Real addresses, not placeholder markers. Valid ONLY for this deployer at this nonce:\n",
            "//   deployer    ",
            vm.toString(deployer),
            "\n",
            "//   start nonce ",
            vm.toString(nonce),
            "\n"
        );

        content = string.concat(content, _constant("ACL_ADDRESS", aclProxy));
        content = string.concat(content, _constant("FHEVM_EXECUTOR_ADDRESS", fhevmExecutorProxy));
        content = string.concat(content, _constant("KMS_VERIFIER_ADDRESS", kmsVerifierProxy));
        content = string.concat(content, _constant("INPUT_VERIFIER_ADDRESS", inputVerifierProxy));
        content = string.concat(content, _constant("HCU_LIMIT_ADDRESS", hcuLimitProxy));
        content = string.concat(content, _constant("CLEARTEXT_ARITHMETIC_ADDRESS", cleartextArithmeticProxy));
        content = string.concat(content, _constant("CLEARTEXT_DB_ADDRESS", cleartextDbProxy));
        content = string.concat(content, _constant("PAUSER_SET_ADDRESS", pauserSetAddr));

        // forge-lint: disable-next-line(unsafe-cheatcode)
        vm.createDir(ADDRESSES_DIR, true);
        // forge-lint: disable-next-line(unsafe-cheatcode)
        vm.writeFile(ADDRESSES_FILE, content);
        console.log("");
        console.log("Written:", ADDRESSES_FILE);
        console.log("Next: forge build with fhevm-config-0.12.0/ remapped to", ADDRESSES_DIR);
    }

    /// @dev One `address constant NAME = address(0x...);` declaration.
    function _constant(string memory name, address value) private view returns (string memory) {
        return string.concat("\naddress constant ", name, " = address(", vm.toString(value), ");\n");
    }
}
