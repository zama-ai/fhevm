pragma solidity ^0.8.24;

import {console} from "forge-std/Script.sol";
import {FhevmUpgradeBase} from "./FhevmUpgradeBase.s.sol";

/**
 *  Two-pass CREATE2 computation for upgrading a supplied live v12 stack.
 */
contract FhevmComputeUpgradeAddresses is FhevmUpgradeBase {
    function run() external {
        _loadUpgradeConfig();
        vm.createDir(cfg.outDir, true);
        uint256 pass = vm.envUint("FHEVM_PASS");
        if (pass == 1) _pass1();
        else if (pass == 2) _pass2();
        else revert("FhevmComputeUpgradeAddresses: FHEVM_PASS must be 1 or 2");
    }

    function _pass1() private {
        _banner("upgrade pass 1/2 - empty implementation and new proxies");
        bytes memory emptyCode = _initCode(A_EMPTY_SHARED);
        address emptyImpl = _predictCreate2Address(R_IMPL_EMPTY_SHARED, emptyCode);
        bytes memory proxyCode = _proxyInitCode(emptyImpl, _sharedProxyInitData());
        address protocolConfig = _predictCreate2Address(R_PROTOCOL_CONFIG, proxyCode);
        address kmsGeneration = _predictCreate2Address(R_KMS_GENERATION, proxyCode);

        _writeAddresses(protocolConfig, kmsGeneration);

        string memory o = "upgradePass1";
        vm.serializeBytes32(o, "emptyImplHash", keccak256(emptyCode));
        vm.serializeBytes32(o, "proxyHash", keccak256(proxyCode));
        vm.serializeAddress(o, "emptyImpl", emptyImpl);
        vm.serializeAddress(o, "protocolConfig", protocolConfig);
        string memory out = vm.serializeAddress(o, "kmsGeneration", kmsGeneration);
        vm.writeJson(out, _scratchPath());

        console.log("  IMPL_EMPTY_UUPS_PROXY ", emptyImpl);
        console.log("  PROTOCOL_CONFIG_ADDRESS", protocolConfig);
        console.log("  KMS_GENERATION_ADDRESS ", kmsGeneration);
    }

    function _pass2() private {
        _banner("upgrade pass 2/2 - implementations, assert, seal");
        string memory scratch = vm.readFile(_scratchPath());

        bytes memory emptyCode = _initCode(A_EMPTY_SHARED);
        address emptyImpl = _predictCreate2Address(R_IMPL_EMPTY_SHARED, emptyCode);
        bytes memory proxyCode = _proxyInitCode(emptyImpl, _sharedProxyInitData());
        address protocolConfig = _predictCreate2Address(R_PROTOCOL_CONFIG, proxyCode);
        address kmsGeneration = _predictCreate2Address(R_KMS_GENERATION, proxyCode);

        require(
            keccak256(emptyCode) == vm.parseJsonBytes32(scratch, ".emptyImplHash"), "upgrade pass2: empty impl moved"
        );
        require(
            keccak256(proxyCode) == vm.parseJsonBytes32(scratch, ".proxyHash"), "upgrade pass2: proxy initcode moved"
        );
        require(emptyImpl == vm.parseJsonAddress(scratch, ".emptyImpl"), "upgrade pass2: empty impl address moved");
        require(
            protocolConfig == vm.parseJsonAddress(scratch, ".protocolConfig"),
            "upgrade pass2: ProtocolConfig address moved"
        );
        require(
            kmsGeneration == vm.parseJsonAddress(scratch, ".kmsGeneration"),
            "upgrade pass2: KMSGeneration address moved"
        );

        string[] memory roles = _upgradeProxyRoles();
        address[] memory implementations = new address[](roles.length);
        for (uint256 i; i < roles.length; i++) {
            bytes memory code = _initCode(_upgradeImplArtifact(i));
            require(code.length != 0, string.concat("upgrade pass2: missing artifact for ", roles[i]));
            require(code.length <= MAX_INITCODE_SIZE, string.concat("upgrade pass2: EIP-3860 overflow in ", roles[i]));
            require(
                !_contains(code, address(0xdead1000)),
                string.concat("upgrade pass2: ProtocolConfig marker in ", roles[i])
            );
            require(
                !_contains(code, address(0xdead1001)),
                string.concat("upgrade pass2: KMSGeneration marker in ", roles[i])
            );
            implementations[i] = _predictCreate2Address(_implRole(roles[i]), code);
            console.log(string.concat("  IMPL_", roles[i]), implementations[i]);
        }

        _writeManifest(emptyImpl, protocolConfig, kmsGeneration, implementations);
        console.log("  wrote", _manifestPath());
    }

    function _writeAddresses(address protocolConfig, address kmsGeneration) private {
        string memory source = string.concat(
            "// SPDX-License-Identifier: BSD-3-Clause-Clear\npragma solidity ^0.8.24;\n",
            "// Generated by FhevmComputeUpgradeAddresses; do not edit.\n"
        );
        source = string.concat(source, _constant(R_ACL, existingAcl));
        source = string.concat(source, _constant(R_FHEVM_EXECUTOR, existingExecutor));
        source = string.concat(source, _constant(R_KMS_VERIFIER, existingKmsVerifier));
        source = string.concat(source, _constant(R_INPUT_VERIFIER, existingInputVerifier));
        source = string.concat(source, _constant(R_HCU_LIMIT, existingHcuLimit));
        source = string.concat(source, _constant(R_PROTOCOL_CONFIG, protocolConfig));
        source = string.concat(source, _constant(R_KMS_GENERATION, kmsGeneration));
        source = string.concat(source, _constant(R_CLEARTEXT_ARITHMETIC, existingArithmetic));
        source = string.concat(source, _constant(R_CLEARTEXT_DB, existingDb));
        source = string.concat(source, _constant(R_PAUSER_SET, existingPauserSet));
        vm.writeFile(_addressesPath(), source);
    }

    function _constant(string memory name, address value) private pure returns (string memory) {
        return string.concat("address constant ", name, " = address(", vm.toString(value), ");\n");
    }

    function _writeManifest(
        address emptyImpl,
        address protocolConfig,
        address kmsGeneration,
        address[] memory implementations
    ) private {
        string memory addressMap = _serializeAddresses(emptyImpl, protocolConfig, kmsGeneration, implementations);
        string memory o = "upgradeManifest";
        vm.serializeUint(o, "chainId", cfg.chainId);
        vm.serializeString(o, "version", cfg.version);
        vm.serializeString(o, "deploymentId", cfg.deploymentId);
        vm.serializeAddress(o, "deployer", cfg.deployer);
        vm.serializeAddress(o, "admin", cfg.admin);
        vm.serializeAddress(o, "factory", CREATE2_FACTORY);
        vm.serializeUint(o, "confirmations", cfg.confirmations);
        string memory out = vm.serializeString(o, "address", addressMap);
        vm.writeJson(out, _manifestPath());
    }

    function _serializeAddresses(
        address emptyImpl,
        address protocolConfig,
        address kmsGeneration,
        address[] memory implementations
    ) private returns (string memory out) {
        string memory o = "upgradeAddressMap";
        vm.serializeAddress(o, R_ACL, existingAcl);
        vm.serializeAddress(o, R_FHEVM_EXECUTOR, existingExecutor);
        vm.serializeAddress(o, R_KMS_VERIFIER, existingKmsVerifier);
        vm.serializeAddress(o, R_INPUT_VERIFIER, existingInputVerifier);
        vm.serializeAddress(o, R_HCU_LIMIT, existingHcuLimit);
        vm.serializeAddress(o, R_PROTOCOL_CONFIG, protocolConfig);
        vm.serializeAddress(o, R_KMS_GENERATION, kmsGeneration);
        vm.serializeAddress(o, R_CLEARTEXT_ARITHMETIC, existingArithmetic);
        vm.serializeAddress(o, R_CLEARTEXT_DB, existingDb);
        vm.serializeAddress(o, R_PAUSER_SET, existingPauserSet);
        vm.serializeAddress(o, R_ACL_OWNER, existingAclOwner);
        vm.serializeAddress(o, R_IMPL_EMPTY_SHARED, emptyImpl);

        string[] memory roles = _upgradeProxyRoles();
        require(implementations.length == roles.length, "FhevmComputeUpgradeAddresses: implementation arity");
        for (uint256 i; i + 1 < roles.length; i++) {
            vm.serializeAddress(o, _implRole(roles[i]), implementations[i]);
        }
        out = vm.serializeAddress(o, _implRole(roles[roles.length - 1]), implementations[roles.length - 1]);
    }

    function _contains(bytes memory haystack, address needle) private pure returns (bool) {
        bytes20 target = bytes20(needle);
        if (haystack.length < 20) return false;
        for (uint256 i; i <= haystack.length - 20; i++) {
            bool match_ = true;
            for (uint256 j; j < 20; j++) {
                if (haystack[i + j] != target[j]) {
                    match_ = false;
                    break;
                }
            }
            if (match_) return true;
        }
        return false;
    }
}
