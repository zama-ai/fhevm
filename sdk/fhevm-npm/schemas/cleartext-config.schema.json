{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zama-ai/fhevm/blob/main/sdk/fhevm-npm/schemas/cleartext-config.schema.json",
  "title": "fhevm cleartext configuration",
  "description": "Source of truth for values shared by the generated TypeScript, Solidity, and shell cleartext configuration faces.",
  "$comment": "This schema validates local structure. fhevm-npm additionally validates cross-entry aliases, derived formulas, checksummed addresses, CREATE address derivations, nonce ordering, and generated-file drift.",
  "type": "object",
  "required": ["$schema", "_readme", "appliesTo", "constants", "localhost"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "./fhevm-npm/schemas/cleartext-config.schema.json" },
    "_readme": { "$ref": "#/$defs/proseLines" },
    "appliesTo": {
      "type": "object",
      "required": ["generations"],
      "additionalProperties": false,
      "properties": {
        "generations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^v[0-9]+$" }
        },
        "_note": { "$ref": "#/$defs/prose" }
      }
    },
    "constants": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]*$" },
      "additionalProperties": { "$ref": "#/$defs/constant" }
    },
    "localhost": { "$ref": "#/$defs/localhost" }
  },
  "$defs": {
    "prose": {
      "oneOf": [{ "type": "string", "minLength": 1 }, { "$ref": "#/$defs/proseLines" }]
    },
    "proseLines": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "decimalString": { "type": "string", "pattern": "^[0-9]+$" },
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "constant": {
      "type": "object",
      "required": ["ts", "solidity", "note"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string" },
        "alias": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "ts": { "enum": ["bigint", "number", "string"] },
        "tsEmit": { "const": "bigint" },
        "solidity": { "type": "string", "pattern": "^(string|address|bytes32|u?int[0-9]*|bool)$" },
        "formula": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 }
      },
      "oneOf": [
        { "required": ["value"], "not": { "required": ["alias"] } },
        { "required": ["alias"], "not": { "required": ["value"] } }
      ],
      "allOf": [
        {
          "if": { "properties": { "ts": { "enum": ["bigint", "number"] } }, "required": ["ts"] },
          "then": { "properties": { "value": { "$ref": "#/$defs/decimalString" } } }
        },
        {
          "if": { "properties": { "ts": { "const": "string" } }, "required": ["ts"] },
          "then": { "not": { "required": ["tsEmit"] } }
        }
      ]
    },
    "documentedValue": {
      "type": "object",
      "required": ["value", "note"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string" },
        "derivation": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "nonce": {
      "type": "object",
      "required": ["nonce", "address", "role"],
      "additionalProperties": false,
      "properties": {
        "nonce": { "type": "integer", "minimum": 0 },
        "address": { "$ref": "#/$defs/address" },
        "role": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" }
      }
    },
    "generation": {
      "type": "object",
      "required": ["PROXY_COUNT", "ADDRESSED_NONCE_COUNT", "nonces"],
      "additionalProperties": false,
      "properties": {
        "PROXY_COUNT": { "$ref": "#/$defs/decimalString" },
        "ADDRESSED_NONCE_COUNT": { "$ref": "#/$defs/decimalString" },
        "_note": { "$ref": "#/$defs/prose" },
        "nonces": {
          "type": "object",
          "required": ["primary", "secondary"],
          "additionalProperties": false,
          "properties": {
            "primary": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonce" } },
            "secondary": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/nonce" } }
          }
        }
      }
    },
    "localhost": {
      "type": "object",
      "required": [
        "chainId",
        "MNEMONIC",
        "DEPLOYER_ADDRESS_INDEX",
        "DEPLOYER_ADDRESS",
        "DEPLOYER_START_NONCE",
        "zamaConfigLocal",
        "generations"
      ],
      "additionalProperties": false,
      "properties": {
        "_note": { "$ref": "#/$defs/prose" },
        "chainId": {
          "allOf": [
            { "$ref": "#/$defs/documentedValue" },
            { "properties": { "value": { "$ref": "#/$defs/decimalString" } } }
          ]
        },
        "MNEMONIC": { "$ref": "#/$defs/documentedValue" },
        "DEPLOYER_ADDRESS_INDEX": {
          "allOf": [
            { "$ref": "#/$defs/documentedValue" },
            { "properties": { "value": { "$ref": "#/$defs/decimalString" } } }
          ]
        },
        "DEPLOYER_ADDRESS": {
          "allOf": [{ "$ref": "#/$defs/documentedValue" }, { "properties": { "value": { "$ref": "#/$defs/address" } } }]
        },
        "DEPLOYER_START_NONCE": {
          "allOf": [
            { "$ref": "#/$defs/documentedValue" },
            { "properties": { "value": { "$ref": "#/$defs/decimalString" } } }
          ]
        },
        "zamaConfigLocal": {
          "type": "object",
          "required": ["ACLAddress", "CoprocessorAddress", "KMSVerifierAddress"],
          "additionalProperties": false,
          "properties": {
            "_note": { "$ref": "#/$defs/prose" },
            "ACLAddress": { "$ref": "#/$defs/address" },
            "CoprocessorAddress": { "$ref": "#/$defs/address" },
            "KMSVerifierAddress": { "$ref": "#/$defs/address" }
          }
        },
        "generations": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "additionalProperties": { "$ref": "#/$defs/generation" }
        }
      }
    }
  }
}
