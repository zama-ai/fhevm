{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zama-ai/fhevm/blob/main/sdk/fhevm-npm/schemas/fhevm-chains.config.schema.json",
  "title": "fhevm chains configuration",
  "description": "Generated network-group, host-chain, gateway, relayer, and deployed-contract configuration.",
  "$comment": "This schema validates local structure. fhevm-npm additionally validates unique host chain IDs within a group and drift from the pinned protocol registry.",
  "type": "object",
  "required": ["$schema", "_readme", "source", "networks"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "./fhevm-npm/schemas/fhevm-chains.config.schema.json" },
    "_readme": { "$ref": "#/$defs/proseLines" },
    "source": {
      "type": "object",
      "required": ["repository", "commit", "files"],
      "additionalProperties": false,
      "properties": {
        "repository": { "const": "https://github.com/zama-ai/protocol-registry-internal" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "files": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^dist/[a-z0-9_-]+\\.json$" }
        }
      }
    },
    "networks": {
      "type": "object",
      "required": ["mainnet", "testnet", "devnet"],
      "additionalProperties": false,
      "properties": {
        "mainnet": { "$ref": "#/$defs/network" },
        "testnet": { "$ref": "#/$defs/network" },
        "devnet": { "$ref": "#/$defs/network" }
      }
    }
  },
  "$defs": {
    "proseLines": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "addressEntry": {
      "type": "object",
      "required": ["address"],
      "additionalProperties": false,
      "properties": { "address": { "$ref": "#/$defs/address" } }
    },
    "hostContracts": {
      "type": "object",
      "required": ["acl", "fhevmExecutor", "hcuLimit", "inputVerifier", "kmsVerifier", "pauserSet"],
      "additionalProperties": false,
      "properties": {
        "acl": { "$ref": "#/$defs/addressEntry" },
        "fhevmExecutor": { "$ref": "#/$defs/addressEntry" },
        "hcuLimit": { "$ref": "#/$defs/addressEntry" },
        "inputVerifier": { "$ref": "#/$defs/addressEntry" },
        "kmsGeneration": { "$ref": "#/$defs/addressEntry" },
        "kmsVerifier": { "$ref": "#/$defs/addressEntry" },
        "pauserSet": { "$ref": "#/$defs/addressEntry" },
        "protocolConfig": { "$ref": "#/$defs/addressEntry" }
      }
    },
    "gatewayContracts": {
      "type": "object",
      "required": ["ciphertextCommits", "decryption", "gatewayConfig", "inputVerification", "pauserSet"],
      "additionalProperties": false,
      "properties": {
        "ciphertextCommits": { "$ref": "#/$defs/addressEntry" },
        "decryption": { "$ref": "#/$defs/addressEntry" },
        "gatewayConfig": { "$ref": "#/$defs/addressEntry" },
        "inputVerification": { "$ref": "#/$defs/addressEntry" },
        "kmsGeneration": { "$ref": "#/$defs/addressEntry" },
        "multichainAcl": { "$ref": "#/$defs/addressEntry" },
        "pauserSet": { "$ref": "#/$defs/addressEntry" }
      }
    },
    "hostChain": {
      "type": "object",
      "required": ["id", "contracts"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "contracts": { "$ref": "#/$defs/hostContracts" }
      }
    },
    "gatewayChain": {
      "type": "object",
      "required": ["id", "contracts"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "contracts": { "$ref": "#/$defs/gatewayContracts" }
      }
    },
    "network": {
      "type": "object",
      "required": ["relayerUrl", "gateway", "hosts"],
      "additionalProperties": false,
      "properties": {
        "relayerUrl": { "type": "string", "pattern": "^https?://\\S+$" },
        "gateway": { "$ref": "#/$defs/gatewayChain" },
        "hosts": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
          "additionalProperties": { "$ref": "#/$defs/hostChain" }
        }
      }
    }
  }
}
