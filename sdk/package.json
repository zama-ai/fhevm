{
  "name": "fhevm-sdk-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "workspaces": [
    "common",
    "common-vendored",
    "host-contracts-cleartext/v12",
    "host-contracts-cleartext/v13",
    "host-contracts-cleartext/v13/pkg",
    "hardhat/v2/plugin",
    "hardhat/v2/plugin/pkg",
    "hardhat/v2/e2e"
  ],
  "scripts": {
    "build": "npm run clean && npm run check && npm run sync:vendored && npm run prettier:check && npm run forge:fmt:check && npm run lint && npm run build --workspaces --if-present",
    "check": "npm run check:foundry && npm run check:vendored-sync && npm run check:dep-versions && npm run check:tsconfig-paths && npm run check:pack-scripts",
    "check:dep-versions": "\"$(npm prefix)/scripts/check-dep-versions.ts\"",
    "check:foundry": "node ./fhevm-npm/fhevm-npm.ts check-foundry",
    "check:lint-policy": "\"$(npm prefix)/scripts/check-lint-policy.sh\"",
    "check:pack-scripts": "\"$(npm prefix)/scripts/check-pack-scripts.ts\"",
    "check:tsconfig-paths": "\"$(npm prefix)/scripts/check-tsconfig-paths.ts\"",
    "check:vendored": "node ./fhevm-npm/fhevm-npm.ts check-vendored",
    "check:vendored-sync": "node ./fhevm-npm/fhevm-npm.ts sync-vendored --check",
    "clean": "npm run clean --workspaces --if-present && npm run clean:tarballs",
    "clean:tarballs": "rm -rf ./tarballs",
    "clone:hardhat-template-v2": "\"$(npm prefix)/scripts/clone-hardhat-template-v2.ts\"",
    "forge:fmt": "npm run forge:fmt --workspaces --if-present",
    "forge:fmt:check": "npm run forge:fmt:check --workspaces --if-present",
    "forge:lint": "npm run forge:lint --workspaces --if-present",
    "install:forge-dependencies": "node ./fhevm-npm/fhevm-npm.ts install-forge-dependencies",
    "lint": "npm run lint --workspaces --if-present",
    "pack:tarballs": "npm run pack:tarball --workspaces --if-present -- --out-dir \"$(npm prefix)/tarballs\"",
    "prettier:check": "npm run prettier:check --workspaces --if-present",
    "prettier:write": "npm run prettier:write --workspaces --if-present",
    "rebuild_and_test": "npm run build && npm run test",
    "setup:hardhat-template-v2": "\"$(npm prefix)/scripts/setup-hardhat-template-v2.ts\"",
    "sync:vendored": "node ./fhevm-npm/fhevm-npm.ts sync-vendored",
    "test": "npm run test --workspaces --if-present",
    "test:consumer": "npm run test:consumer --workspaces --if-present",
    "test:consumer:ci": "npm run test:consumer --workspaces --if-present -- --ci"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.0.2",
    "ethers": "6.17.0",
    "prettier": "^3.8.3",
    "publint": "^0.2.12",
    "tsx": "^4.23.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.2",
    "viem": "2.55.19",
    "vitest": "^4.0.18"
  }
}
