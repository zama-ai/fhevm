{
  "name": "@fhevm/hardhat-plugin",
  "version": "0.4.2",
  "description": "FHEVM Hardhat Plugin v2",
  "license": "BSD-3-Clause-Clear",
  "type": "commonjs",
  "homepage": "https://github.com/zama-ai/fhevm/blob/main/sdk/hardhat/v2/README.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zama-ai/fhevm.git"
  },
  "keywords": [
    "fhevm",
    "zama",
    "eth",
    "ethereum",
    "dapps",
    "web3",
    "typescript",
    "hardhat"
  ],
  "engines": {
    "node": ">=20",
    "npm": ">=7.0.0"
  },
  "main": "./_cjs/index.js",
  "types": "./_types/index.d.ts",
  "typings": "./_types/index.d.ts",
  "sideEffects": false,
  "files": [
    "src/*",
    "_cjs/*",
    "_types/*",
    "!**/tsconfig*.json",
    "!**/*.tsbuildinfo"
  ],
  "exports": {
    ".": {
      "types": "./_types/index.d.ts",
      "require": "./_cjs/index.js",
      "default": "./_cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@fhevm/host-contracts-cleartext": "0.13.0",
    "debug": "^4.1.1",
    "dotenv": "^16.5.0",
    "picocolors": "^1.1.1",
    "resolve": "1.17.0"
  },
  "peerDependencies": {
    "@fhevm/sdk": "^0.13.3",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "ethers": "^6.17.0",
    "hardhat": "^2.0.0"
  }
}
