{
  "name": "@fhevm/hardhat-plugin-v2-dev",
  "description": "HARNESS for @fhevm/hardhat-plugin. Never published. The payload is ./pkg.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build": "npm run clean && npm run test:vendored && npm run prettier:check && npm run lint && npm run build:cjs && npm run build:types && npm run test:publint",
    "build:cjs": "tsc --project ./tsconfig.build.cjs.json && printf '{\"type\":\"commonjs\"}' > ./pkg/_cjs/package.json",
    "build:types": "tsc --project ./tsconfig.build.types.json",
    "check:lint-policy": "\"$(npm prefix)/scripts/check-lint-policy.sh\"",
    "clean": "rm -rf pkg/_cjs pkg/_types *.tsbuildinfo internal/*.tsbuildinfo test/*.tsbuildinfo pkg/*.tsbuildinfo",
    "lint": "npm run check:lint-policy && eslint && tsc -b ./tsconfig.json --noEmit",
    "pack:tarball": "\"$(npm prefix)/scripts/pack-tarball.ts\"",
    "prettier:check": "prettier --check \"**/*.{js,json,md,mjs,ts,yml}\"",
    "prettier:write": "prettier --write \"**/*.{js,json,md,mjs,ts,yml}\"",
    "test": "node --test test/*.test.ts",
    "test:consumer": "node ./internal/test-consumer.ts",
    "test:publint": "publint --strict ./pkg && attw --pack ./pkg",
    "test:vendored": "node ../../../fhevm-npm/fhevm-npm.ts check-vendored ./hardhat/v2/plugin"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@fhevm/sdk": "^0.13.3",
    "@fhevm/sdk-common-dev": "0.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@types/debug": "^4.1.13",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/resolve": "^1.20.6",
    "eslint": "^10.0.2",
    "hardhat": "^2.28.6",
    "prettier": "^3.8.3",
    "publint": "^0.2.12",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.2"
  }
}
