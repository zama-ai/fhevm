{
  "name": "@fhevm/hardhat-plugin-v2-dev",
  "description": "HARNESS for @fhevm/hardhat-plugin. Never published. The payload is ./pkg.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build": "npm run fmt:check && npm run lint && npm run compile",
    "check": "npm run check:publint && npm run check:vendored-origin",
    "check:publint": "publint --strict ./pkg && attw --pack ./pkg",
    "check:vendored-origin": "node ../../../fhevm-npm/fhevm-npm.ts check-vendored-origin ./hardhat/v2/plugin",
    "clean": "rm -rf pkg/_cjs pkg/_types *.tsbuildinfo internal/*.tsbuildinfo test/*.tsbuildinfo pkg/*.tsbuildinfo",
    "compile": "npm run compile:cjs && npm run compile:types",
    "compile:cjs": "tsc --project ./tsconfig.build.cjs.json && printf '{\"type\":\"commonjs\"}' > ./pkg/_cjs/package.json",
    "compile:types": "tsc --project ./tsconfig.build.types.json",
    "fmt": "npm run prettier:write",
    "fmt:check": "npm run prettier:check",
    "lint": "eslint && tsc -b ./tsconfig.json --noEmit",
    "pack:tarball": "node ../../../fhevm-npm/fhevm-npm.ts pack-tarball ./hardhat/v2/plugin",
    "prettier:check": "prettier --check \"**/*.{js,json,md,mjs,ts,yml}\"",
    "prettier:write": "prettier --write \"**/*.{js,json,md,mjs,ts,yml}\"",
    "test": "node --test test/*.test.ts",
    "test:consumer": "node ./internal/test-consumer.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@fhevm/sdk": "^0.13.3",
    "@fhevm/sdk-common-dev": "0.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@types/debug": "^4.1.13",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@types/resolve": "^1.20.6",
    "eslint": "^10.0.2",
    "hardhat": "^2.28.6",
    "prettier": "^3.8.3",
    "publint": "^0.2.12",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.2"
  }
}
