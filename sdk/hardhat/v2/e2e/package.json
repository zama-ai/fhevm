{
  "name": "@fhevm/hardhat-plugin-v2-e2e-dev",
  "version": "0.0.0",
  "description": "e2e test suite for Hardhat plugin v2 (cjs only)",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run fmt:check && npm run lint && npm run compile",
    "clean": "rm -rf artifacts cache cache-forge typechain-types out broadcast *.tsbuildinfo",
    "compile": "hardhat compile && tsc --noEmit",
    "fmt": "npm run prettier:write && npm run forge:fmt",
    "fmt:check": "npm run prettier:check && npm run forge:fmt:check",
    "forge:fmt": "forge fmt",
    "forge:fmt:check": "forge fmt --check",
    "forge:lint": "forge lint",
    "lint": "npm run typechain && npm run forge:lint && eslint && tsc -b ./tsconfig.json --noEmit",
    "prettier:check": "prettier --check \"**/*.{js,json,md,mjs,ts,yml}\"",
    "prettier:write": "prettier --write \"**/*.{js,json,md,mjs,ts,yml}\"",
    "test": "cross-env HARDHAT_NETWORK=hardhat npx hardhat test",
    "test:anvil": "cross-env HARDHAT_NETWORK=anvil npx hardhat test",
    "test:anvil:simple": "cross-env HARDHAT_NETWORK=anvil npx hardhat test --grep 'increment the counter by 123 and verify public decrypt'",
    "test:node": "cross-env HARDHAT_NETWORK=localhost npx hardhat test",
    "test:sepolia:devnet": "cross-env HARDHAT_NETWORK=devnet npx hardhat test --grep 'Sepolia:FHECounterPublicDecrypt:IncrementAndPublicDecrypt:'",
    "test:sepolia:testnet": "cross-env HARDHAT_NETWORK=sepolia npx hardhat test --grep 'Sepolia:FHECounterPublicDecrypt:IncrementAndPublicDecrypt:'",
    "typechain": "cross-env TS_NODE_TRANSPILE_ONLY=true hardhat typechain"
  },
  "dependencies": {
    "@fhevm/solidity": "^0.13.3",
    "@openzeppelin/contracts": "5.1.0"
  },
  "devDependencies": {
    "@fhevm/hardhat-plugin": "0.4.2",
    "@fhevm/host-contracts-cleartext": "file:../../../host-contracts-cleartext/v13/pkg",
    "@fhevm/sdk": "^0.13.3",
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/chai-as-promised": "^7.1.8",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "chai": "^4.5.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.0.2",
    "ethers": "6.17.0",
    "hardhat": "^2.28.6",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  }
}
