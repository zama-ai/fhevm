{
  "name": "fhevm-hardhat-template-v3-dev",
  "version": "0.0.0",
  "description": "Hardhat v3 based template for developing FHEVM Solidity smart contracts",
  "private": true,
  "license": "BSD-3-Clause-Clear",
  "type": "module",
  "homepage": "https://github.com/zama-ai/fhevm-hardhat-template/README.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zama-ai/fhevm-hardhat-template.git"
  },
  "keywords": [
    "fhevm",
    "zama",
    "eth",
    "ethereum",
    "dapps",
    "wallet",
    "web3",
    "typescript",
    "hardhat"
  ],
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "files": [
    "contracts"
  ],
  "scripts": {
    "build:ts": "tsc --project tsconfig.json --noEmit",
    "chain": "hardhat node --network hardhatMainnet",
    "clean": "rimraf ./artifacts ./cache ./coverage ./dist ./ignition/deployments ./*.tsbuildinfo",
    "compile": "hardhat build",
    "deploy:localhost": "hardhat ignition deploy --network localhost ignition/modules/FHECounter.ts",
    "deploy:sepolia": "hardhat ignition deploy --network sepolia ignition/modules/FHECounter.ts",
    "fmt": "npm run prettier:write && npm run forge:fmt",
    "fmt:check": "npm run prettier:check && npm run forge:fmt:check",
    "forge:fmt": "forge fmt contracts",
    "forge:fmt:check": "forge fmt --check contracts",
    "forge:lint": "cd ../.. && forge lint --root . --contracts fhevm-hardhat-template/pkg/contracts --remappings '@fhevm/solidity/=node_modules/@fhevm/solidity/' --remappings 'encrypted-types/=node_modules/encrypted-types/'",
    "lint": "npm run lint:ts && npm run forge:lint && npm run prettier:check",
    "lint:ts": "eslint .",
    "prettier:check": "prettier --check \"**/*.{js,json,md,ts,yml}\"",
    "prettier:write": "prettier --write \"**/*.{js,json,md,ts,yml}\"",
    "test": "hardhat test",
    "test:coverage": "hardhat test --coverage",
    "test:sepolia": "hardhat test --network sepolia",
    "verify:sepolia": "hardhat verify --network sepolia"
  },
  "dependencies": {
    "@fhevm/solidity": "0.13.3",
    "encrypted-types": "^0.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fhevm/hardhat-plugin-v3": "0.13.0",
    "@fhevm/sdk": "0.13.3",
    "@nomicfoundation/hardhat-ignition": "^3.1.8",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@types/node": "^22.0.0",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "hardhat": "^3.0.0",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.2",
    "viem": "2.55.19"
  },
  "overrides": {
    "ws@>=7.0.0 <7.5.10": ">=7.5.10",
    "axios@>=1.3.2 <=1.7.3": ">=1.7.4",
    "elliptic@>=4.0.0 <=6.5.6": ">=6.5.7",
    "elliptic@>=2.0.0 <=6.5.6": ">=6.5.7",
    "elliptic@>=5.2.1 <=6.5.6": ">=6.5.7",
    "micromatch@<4.0.8": ">=4.0.8",
    "elliptic@<6.6.0": ">=6.6.0",
    "elliptic@<6.5.6": ">=6.5.6",
    "undici@>=6.0.0 <6.21.1": ">=6.21.1 <7.0.0",
    "undici@>=4.5.0 <5.28.5": ">=5.28.5 <6.0.0",
    "elliptic@<=6.6.0": ">=6.6.1",
    "tar-fs@>=2.0.0 <2.1.2": ">=2.1.2",
    "axios@>=1.0.0 <1.8.2": ">=1.8.2",
    "axios@<0.29.1": ">=0.29.1",
    "cookie@<0.7.0": ">=0.7.0",
    "minimatch": "^3.1.2"
  }
}
