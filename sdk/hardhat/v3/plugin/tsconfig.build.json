{
  "//": "Compiles the ESM payload; the types emit reuses this project with declaration flags.",
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./pkg/src",
    "outDir": "./pkg/_esm",
    "types": ["node"],
    "noEmitOnError": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "module": "nodenext",
    "moduleResolution": "nodenext"
  },
  "include": ["pkg/src"]
}
