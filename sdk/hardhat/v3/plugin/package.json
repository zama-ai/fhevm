{
  "name": "@fhevm/hardhat-plugin-v3-dev",
  "description": "Dev package for the hardhat v3 fhevm plugin. Never published. The published package is ./pkg.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run fmt:check && npm run lint && npm run compile",
    "check": "npm run check:publint && npm run check:vendored-origin",
    "check:publint": "publint --strict ./pkg && attw --pack ./pkg",
    "check:vendored-origin": "node ../../../fhevm-npm/fhevm-npm.ts check-vendored-origin ./hardhat/v3/plugin",
    "clean": "rm -rf pkg/_esm *.tsbuildinfo test/*.tsbuildinfo pkg/*.tsbuildinfo",
    "compile": "npm run compile:esm",
    "compile:esm": "tsc --project ./tsconfig.build.esm.json --outDir ./pkg/_esm --declaration --declarationMap",
    "fmt": "npm run prettier:write",
    "fmt:check": "npm run prettier:check",
    "lint": "npm run compile && eslint && tsc -b ./tsconfig.json --noEmit",
    "pack:tarball": "node ../../../fhevm-npm/fhevm-npm.ts pack-tarball ./hardhat/v3/plugin",
    "prettier:check": "prettier --check \"**/*.{js,json,md,mjs,ts,yml}\"",
    "prettier:write": "prettier --write \"**/*.{js,json,md,mjs,ts,yml}\"",
    "test": "node --test test/*.test.ts",
    "test:consumer": "node ../../../fhevm-npm/fhevm-npm.ts test-consumer ./hardhat/v3/plugin"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@fhevm/sdk": "0.13.3",
    "@types/node": "^22.0.0",
    "eslint": "^10.0.2",
    "hardhat": "^3.0.0",
    "prettier": "^3.8.3",
    "publint": "^0.2.12",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.2",
    "viem": "2.55.19"
  }
}
