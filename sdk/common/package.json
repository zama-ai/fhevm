{
  "name": "@fhevm/sdk-common-dev",
  "version": "0.0.0",
  "description": "Internal helpers shared by the sdk workspace's harnesses. Never published.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "exports": {
    ".": "./src/index.ts",
    "./anvil.ts": "./src/anvil.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf *.tsbuildinfo src/*.tsbuildinfo test/*.tsbuildinfo",
    "fmt": "npm run prettier:write",
    "fmt:check": "npm run prettier:check",
    "lint": "eslint && tsc -p ./tsconfig.json --noEmit",
    "prettier:check": "prettier --check \"**/*.{js,json,md,mjs,ts,yml}\"",
    "prettier:write": "prettier --write \"**/*.{js,json,md,mjs,ts,yml}\""
  },
  "dependencies": {
    "viem": "2.55.19"
  },
  "devDependencies": {
    "eslint": "^10.0.2",
    "prettier": "^3.8.3",
    "typescript": "^6.0.2"
  }
}
